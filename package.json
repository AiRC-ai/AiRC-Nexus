{
  "name": "airc-nexus",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "description": "Local AiRC Nexus evidence-reuse prototype",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && vite build --config apps/web/vite.config.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:mcp": "vitest run tests/integration/mcp.test.ts",
    "start": "node dist/apps/server/main.js",
    "mcp": "node dist/apps/mcp/main.js",
    "worker": "node dist/apps/worker/main.js",
    "db:migrate": "node dist/scripts/migrate.js",
    "db:seed": "node dist/scripts/seed.js",
    "dev": "tsx apps/server/main.ts",
    "dev:web": "vite build --watch --config apps/web/vite.config.ts",
    "setup": "tsx scripts/bootstrap.ts",
    "demo": "node scripts/demo.mjs",
    "demo:stop": "node scripts/demo.mjs --stop",
    "format:check": "prettier --check apps packages scripts tests fixtures evals package.json tsconfig.json vitest.config.ts playwright.config.ts compose.yaml deploy",
    "test:e2e": "playwright test",
    "seed:exchange": "tsx scripts/seed-exchange.ts",
    "eval:smoke": "tsx evals/smoke.ts",
    "eval:peer": "tsx evals/peer.ts",
    "eval:retrieval": "tsx evals/retrieval.ts",
    "compose:setup": "node scripts/compose.mjs",
    "compose:stop": "node scripts/compose.mjs --stop",
    "verify:restore": "tsx scripts/verify-restore.ts",
    "access:prepare": "tsx scripts/access.ts",
    "access:renew": "tsx scripts/access.ts --renew",
    "deps:inventory": "node scripts/dependency-inventory.mjs",
    "verify:compose": "node scripts/verify-compose.mjs",
    "federation:setup": "tsx scripts/federation-setup.ts",
    "federation:start": "node scripts/federation-demo.mjs",
    "federation:stop": "node scripts/federation-demo.mjs --stop",
    "federation:admin": "tsx scripts/federation-admin.ts",
    "federation:verify": "tsx evals/federation-live.ts",
    "hosted:init": "node dist/scripts/host-init.js",
    "hosted:admin": "node dist/scripts/host-admin.js"
  },
  "dependencies": {
    "@fastify/cookie": "11.1.5",
    "@fastify/helmet": "13.2.0",
    "@fastify/rate-limit": "11.2.2",
    "@fastify/static": "10.1.11",
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/source-serif-4": "5.3.1",
    "@modelcontextprotocol/client": "2.4.0",
    "@modelcontextprotocol/server": "2.4.0",
    "canonicalize": "5.1.0",
    "fastify": "5.12.8",
    "katex": "0.19.1",
    "lucide-react": "1.73.0",
    "pg": "8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "semver": "7.8.6",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.65.1",
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/semver": "7.8.0",
    "@vitejs/plugin-react": "6.3.0",
    "prettier": "3.10.1",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.8",
    "vitest": "5.1.0"
  },
  "license": "Apache-2.0"
}
